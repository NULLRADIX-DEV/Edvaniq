<?xml version="1.0" encoding="utf-8"?>
<!-- Edvaniq takes its packages from nuget.org only, on every machine and in the CI, whatever the personal NuGet
     configuration holds. A source there that is gone does not break the restore, and a foreign one cannot slip in a
     package of the same name. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
