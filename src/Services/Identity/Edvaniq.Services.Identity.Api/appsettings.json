{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Tokens": {
    "Audience": "edvaniq-api",
    "Lifetime": "00:05:00",
    "UserLifetime": "01:00:00",
    "Clients": {
      "web": {
        "AllowPassword": true
      },
      "content": {
        "Audience": "edvaniq-internal"
      }
    }
  }
}
