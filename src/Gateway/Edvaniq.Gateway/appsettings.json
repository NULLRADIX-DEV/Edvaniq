{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "ValidAudiences": [ "edvaniq-api" ]
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "planning": {
        "ClusterId": "planning",
        "Match": {
          "Path": "/planning/{**rest}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/planning" }
        ]
      },
      "content": {
        "ClusterId": "content",
        "Match": {
          "Path": "/content/{**rest}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/content" }
        ]
      },
      "knowledge": {
        "ClusterId": "knowledge",
        "Match": {
          "Path": "/knowledge/{**rest}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/knowledge" }
        ]
      },
      "assessment": {
        "ClusterId": "assessment",
        "Match": {
          "Path": "/assessment/{**rest}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/assessment" }
        ]
      },
      "learningengine": {
        "ClusterId": "learningengine",
        "Match": {
          "Path": "/learningengine/{**rest}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/learningengine" }
        ]
      },
      "identity-token": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/identity/connect/token",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/identity" }
        ]
      }
    },
    "Clusters": {
      "planning": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:08"
        },
        "Destinations": {
          "planning-api": {
            "Address": "https+http://planning-api"
          }
        }
      },
      "content": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:08"
        },
        "Destinations": {
          "content-api": {
            "Address": "https+http://content-api"
          }
        }
      },
      "knowledge": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:08"
        },
        "Destinations": {
          "knowledge-api": {
            "Address": "https+http://knowledge-api"
          }
        }
      },
      "assessment": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:08"
        },
        "Destinations": {
          "assessment-api": {
            "Address": "https+http://assessment-api"
          }
        }
      },
      "learningengine": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:08"
        },
        "Destinations": {
          "learningengine-api": {
            "Address": "https+http://learningengine-api"
          }
        }
      },
      "identity": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:08"
        },
        "Destinations": {
          "identity-api": {
            "Address": "https+http://identity-api"
          }
        }
      }
    }
  }
}
