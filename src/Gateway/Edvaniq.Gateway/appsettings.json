{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 21037056
    }
  },
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "ValidAudiences": [ "edvaniq-api" ]
      }
    }
  },
  // Per account and minute (AccountRateLimits). Far above what a person does, low enough to stop a script.
  "RateLimits": {
    // A summary costs AI, so do new documents and retries. Three lengths for a few topics stay well below.
    "ai": { "PermitsPerMinute": 20 },
    // Each question is one call to ask and one to answer. A 20 question quiz answered offline and sent at once after the
    // connection is back takes 40 of them, a second quiz on top still fits. Nobody who reads answers this fast.
    "answers": { "PermitsPerMinute": 120 },
    // Start, advance, complete, abort and a later heartbeat of at most one a second.
    "sessions": { "PermitsPerMinute": 60 }
  },
  "ReverseProxy": {
    "Routes": {
      // Ahead of the prefix routes (Order), each with its limit. A POST under these paths gets the limit too.
      "content-ai-documents": {
        "ClusterId": "content",
        "Order": -1,
        "RateLimiterPolicy": "ai",
        "Match": {
          "Path": "/content/documents/{**rest}",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/content" }
        ]
      },
      "content-ai-topics": {
        "ClusterId": "content",
        "Order": -1,
        "RateLimiterPolicy": "ai",
        "Match": {
          "Path": "/content/topics/{**rest}",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/content" }
        ]
      },
      "assessment-answers-attempts": {
        "ClusterId": "assessment",
        "Order": -1,
        "RateLimiterPolicy": "answers",
        "Match": {
          "Path": "/assessment/attempts/{**rest}",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/assessment" }
        ]
      },
      "assessment-answers-quizzes": {
        "ClusterId": "assessment",
        "Order": -1,
        "RateLimiterPolicy": "answers",
        "Match": {
          "Path": "/assessment/quizzes/{**rest}",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/assessment" }
        ]
      },
      "assessment-answers-check": {
        "ClusterId": "assessment",
        "Order": -1,
        "RateLimiterPolicy": "answers",
        "Match": {
          "Path": "/assessment/check-questions",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/assessment" }
        ]
      },
      "planning-sessions": {
        "ClusterId": "planning",
        "Order": -1,
        "RateLimiterPolicy": "sessions",
        "Match": {
          "Path": "/planning/sessions/{**rest}",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/planning" }
        ]
      },
      "planning": {
        "ClusterId": "planning",
        "Match": {
          "Path": "/planning/{**rest}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/planning" }
        ]
      },
      "content": {
        "ClusterId": "content",
        "Match": {
          "Path": "/content/{**rest}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/content" }
        ]
      },
      "knowledge": {
        "ClusterId": "knowledge",
        "Match": {
          "Path": "/knowledge/{**rest}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/knowledge" }
        ]
      },
      "assessment": {
        "ClusterId": "assessment",
        "Match": {
          "Path": "/assessment/{**rest}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/assessment" }
        ]
      },
      "learningengine": {
        "ClusterId": "learningengine",
        "Match": {
          "Path": "/learningengine/{**rest}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/learningengine" }
        ]
      },
      "identity-accounts": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/identity/accounts",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/identity" }
        ]
      },
      "identity-resend": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/identity/accounts/confirmations/resend",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/identity" }
        ]
      },
      "identity-confirmation": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/identity/accounts/confirmations",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/identity" }
        ]
      },
      "identity-legal-versions": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/identity/legal-versions",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/identity" }
        ]
      },
      "identity-reset": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/identity/accounts/password-resets",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/identity" }
        ]
      },
      "identity-reset-complete": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/identity/accounts/password-resets/complete",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/identity" }
        ]
      },
      "identity-token": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/identity/connect/token",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/identity" }
        ]
      }
    },
    "Clusters": {
      "planning": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:08"
        },
        "Destinations": {
          "planning-api": {
            "Address": "https+http://planning-api"
          }
        }
      },
      "content": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:08"
        },
        "Destinations": {
          "content-api": {
            "Address": "https+http://content-api"
          }
        }
      },
      "knowledge": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:08"
        },
        "Destinations": {
          "knowledge-api": {
            "Address": "https+http://knowledge-api"
          }
        }
      },
      "assessment": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:08"
        },
        "Destinations": {
          "assessment-api": {
            "Address": "https+http://assessment-api"
          }
        }
      },
      "learningengine": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:08"
        },
        "Destinations": {
          "learningengine-api": {
            "Address": "https+http://learningengine-api"
          }
        }
      },
      "identity": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:08"
        },
        "Destinations": {
          "identity-api": {
            "Address": "https+http://identity-api"
          }
        }
      }
    }
  }
}
