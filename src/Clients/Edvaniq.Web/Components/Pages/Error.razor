@page "/Error"
@attribute [ExcludeFromInteractiveRouting]
@using Edvaniq.ServiceDefaults
@using Microsoft.AspNetCore.Diagnostics
@using Edvaniq.Client.UI.Pages

@* Where the exception handler of Program.cs ends up. The page itself lives in Client.UI, this only tells it what the
   request knows: the trace and the address that failed. *@
<ServerError TraceId="@traceId" RetryHref="@retryHref" />

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? traceId;
    private string retryHref = "/";

    protected override void OnInitialized()
    {
        if (HttpContext is null)
        {
            return;
        }

        traceId = HttpContext.GetTraceId();

        // The handler runs the page in place of the failed one. The query is still the one of the failed request, the path
        // is not. Only ever a path on this site, a leading "//" would turn it into another one.
        if (HttpContext.Features.Get<IExceptionHandlerPathFeature>() is { } failed)
        {
            var path = new PathString("/" + failed.Path.TrimStart('/'));
            retryHref = HttpContext.Request.PathBase + path + HttpContext.Request.QueryString;
        }
    }
}