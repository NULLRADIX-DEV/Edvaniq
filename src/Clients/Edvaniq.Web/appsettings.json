{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Login": {
    "PerClientPerMinute": 10
  },
  "BackendToken": {
    "TokenEndpoint": "https+http://gateway/identity/connect/token",
    "ClientId": "web",
    "PerClientPerMinute": 10,
    "TotalPerMinute": 120
  },
  "ReverseProxy": {
    "Routes": {
      "status": {
        "ClusterId": "gateway",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/status"
        },
        "Transforms": [
          { "PathSet": "/status" },
          { "RequestHeaderRemove": "Cookie" },
          { "RequestHeaderRemove": "Authorization" },
          { "ResponseHeaderRemove": "Set-Cookie", "When": "Always" }
        ]
      },
      "ping": {
        "ClusterId": "gateway",
        "AuthorizationPolicy": "session",
        "Metadata": {
          "BackendToken": "true"
        },
        "Match": {
          "Path": "/api/planning/ping",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" },
          { "RequestHeaderRemove": "Cookie" },
          { "RequestHeaderRemove": "Authorization" },
          { "ResponseHeaderRemove": "Set-Cookie", "When": "Always" }
        ]
      },
      "documents": {
        "ClusterId": "gateway",
        "AuthorizationPolicy": "user",
        "Metadata": {
          "BackendToken": "true"
        },
        "Match": {
          "Path": "/api/content/documents",
          "Methods": [ "GET", "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" },
          { "RequestHeaderRemove": "Cookie" },
          { "RequestHeaderRemove": "Authorization" },
          { "ResponseHeaderRemove": "Set-Cookie", "When": "Always" }
        ]
      },
      "topics": {
        "ClusterId": "gateway",
        "AuthorizationPolicy": "user",
        "Metadata": {
          "BackendToken": "true"
        },
        "Match": {
          "Path": "/api/knowledge/topics",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" },
          { "RequestHeaderRemove": "Cookie" },
          { "RequestHeaderRemove": "Authorization" },
          { "ResponseHeaderRemove": "Set-Cookie", "When": "Always" }
        ]
      },
      "mastery": {
        "ClusterId": "gateway",
        "AuthorizationPolicy": "user",
        "Metadata": {
          "BackendToken": "true"
        },
        "Match": {
          "Path": "/api/learningengine/mastery",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" },
          { "RequestHeaderRemove": "Cookie" },
          { "RequestHeaderRemove": "Authorization" },
          { "ResponseHeaderRemove": "Set-Cookie", "When": "Always" }
        ]
      },
      "attempts": {
        "ClusterId": "gateway",
        "AuthorizationPolicy": "user",
        "Metadata": {
          "BackendToken": "true"
        },
        "Match": {
          "Path": "/api/assessment/attempts",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" },
          { "RequestHeaderRemove": "Cookie" },
          { "RequestHeaderRemove": "Authorization" },
          { "ResponseHeaderRemove": "Set-Cookie", "When": "Always" }
        ]
      },
      "answer": {
        "ClusterId": "gateway",
        "AuthorizationPolicy": "user",
        "Metadata": {
          "BackendToken": "true"
        },
        "Match": {
          "Path": "/api/assessment/attempts/{id:guid}/answer",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" },
          { "RequestHeaderRemove": "Cookie" },
          { "RequestHeaderRemove": "Authorization" },
          { "ResponseHeaderRemove": "Set-Cookie", "When": "Always" }
        ]
      }
    },
    "Clusters": {
      "gateway": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:09"
        },
        "Destinations": {
          "gateway": {
            "Address": "https+http://gateway"
          }
        }
      }
    }
  }
}
