@inject ITodayPlan Plans
@inject ILearningMaterial Material
@inject ILearningGoals Goals
@inject AnswerSync Sync

@* The plan is worked out anew on every call, so Home asks on every visit and when the user comes back: after an answer
   in another tab or on another device the order may have changed. *@
<RefreshOnReturn OnReturn="LoadAsync" />

<section class="plan" aria-labelledby="plan-heading">
    <h2 id="plan-heading">Dein Plan für heute</h2>

    @* Minutes, blocks and the exam countdown of the plan shown (#382). A reload replaces the plan, the summary follows. *@
    @if (state == ViewState.Shown)
    {
        <TodaySummary Plan="plan!" />
    }

    @* What the plan is about to say lives in one live region. Topic names come from the analysis, Razor writes them as
       text. *@
    <div class="plan-status" role="status">
        @switch (state)
        {
            case ViewState.Loading:
                <Loading />
                break;
            case ViewState.LoadFailed:
                <ConnectionProblem Title="@FeedbackTexts.Plan.LoadFailed" TraceId="@trace" />
                break;
            case ViewState.Shown when plan!.Blocks.Count == 0:
                <EmptyState Title="@Empty.Title" Hint="@Empty.Hint">
                    @if (plan.Empty == PlanEmpty.AllMastered && !noGoal && !AnalysisIsTheReason)
                    {
                        <p class="plan-bonus">@FeedbackTexts.Plan.Bonus</p>
                    }
                </EmptyState>
                break;
        }

        @* The goal reached is said once, when it comes. A return with the same plan leaves it out of the region, the
           confirmation below stays. *@
        @if (state == ViewState.Shown && announceGoal)
        {
            <p class="visually-hidden plan-goal-announcement">@FeedbackTexts.Plan.GoalReached @FeedbackTexts.Plan.GoalReachedHint</p>
        }

        @* Material in the analysis while the plan already has blocks or another reason to be empty. Without a goal the
           wizard is the one next step. *@
        @if (state == ViewState.Shown && analyzing is not null && !noGoal && !AnalysisIsTheReason)
        {
            <Notice Kind="NoticeKind.Info" Title="@FeedbackTexts.Material.WithTitle(FeedbackTexts.Plan.Analyzing, analyzing.Title)" class="plan-hint plan-analyzing">
                <p><a href="themen">@FeedbackTexts.Plan.AnalyzingLink</a></p>
            </Notice>
        }

        @* An answer just given is on its way to LearningEngine, the plan below doesn't contain it yet. *@
        @if (state == ViewState.Shown && syncing)
        {
            <Notice Kind="NoticeKind.Info" class="plan-updating"><p>@FeedbackTexts.Plan.Updating</p></Notice>
        }
        else if (state == ViewState.Shown && syncLate)
        {
            <Notice Kind="NoticeKind.Info" Title="@FeedbackTexts.Plan.Late" class="plan-late"><p>@FeedbackTexts.Plan.LateHint</p></Notice>
        }
    </div>

    @if (state == ViewState.LoadFailed)
    {
        <StateActions ActionText="@FeedbackTexts.Connection.Retry" OnAction="LoadAsync" />
    }
    else if (state == ViewState.Shown && plan!.Blocks.Count == 0)
    {
        <StateActions Href="@Empty.Href" LinkText="@Empty.Link" />
    }

    @if (state == ViewState.Shown && plan!.DailyGoal == DailyGoal.Reached)
    {
        <Notice Kind="NoticeKind.Success" Title="@FeedbackTexts.Plan.GoalReached" class="plan-goal-reached">
            <p>@FeedbackTexts.Plan.GoalReachedHint</p>
            <p class="plan-bonus">@FeedbackTexts.Plan.Bonus</p>
        </Notice>
    }

    @if (state == ViewState.Shown && syncLate && !syncing)
    {
        <StateActions ActionText="@FeedbackTexts.Plan.Reload" OnAction="LoadAsync" />
    }

    @if (state == ViewState.Shown && plan!.Blocks.Count > 0)
    {
        <ol class="plan-blocks" aria-busy="@(syncing ? "true" : "false")">
            @foreach (var (block, index) in plan.Blocks.Select((block, index) => (block, index)))
            {
                var name = NameOf(block.TopicId);
                <li @key="index" class="@(block.Done ? "plan-block plan-block-done" : "plan-block")">
                    <span class="plan-topic">@name</span>
                    <span class="plan-details">
                        @if (block.Done)
                        {
                            <span class="plan-done">@FeedbackTexts.Plan.Done</span>
                        }
                        @if (KindOf(block.Kind) is { } kind)
                        {
                            <span class="plan-kind">@kind</span>
                        }
                        <span class="plan-minutes">@MinutesOf(block.Minutes)</span>
                    </span>
                    <PracticeLink TopicId="block.TopicId" Name="@name" />
                </li>
            }
        </ol>
    }

    @if (state == ViewState.Shown)
    {
        @if (!plan!.MasteryAvailable)
        {
            <Notice Kind="NoticeKind.Info" class="plan-hint plan-mastery">
                <p>@FeedbackTexts.Plan.MasteryUnavailable</p>
            </Notice>
        }

        @if (plan.ShortenedTopicIds.Count > 0)
        {
            <Notice Kind="NoticeKind.Info" class="plan-hint plan-shortened">
                <p>@FeedbackTexts.Plan.Shortened</p>
                <ul>
                    @foreach (var id in plan.ShortenedTopicIds)
                    {
                        <li @key="id">@NameOf(id)</li>
                    }
                </ul>
            </Notice>
        }

        @* With an empty plan for that reason the hint above already says it. *@
        @if (plan.NotReadyTopicIds.Count > 0 && plan.Empty != PlanEmpty.QuestionsPending)
        {
            <Notice Kind="NoticeKind.Info" class="plan-hint plan-not-ready">
                <p>@FeedbackTexts.Plan.NotReady</p>
                <ul>
                    @foreach (var id in plan.NotReadyTopicIds)
                    {
                        <li @key="id">@NameOf(id)</li>
                    }
                </ul>
            </Notice>
        }
    }
</section>

@code {
    private ViewState state = ViewState.Loading;
    private TodayPlan? plan;
    private Dictionary<Guid, string> names = [];
    private string? trace;
    private int loads;
    private bool syncing;
    private bool syncLate;
    private bool noGoal;
    private DocumentInfo? analyzing;
    private bool announceGoal;

    protected override Task OnInitializedAsync() => LoadAsync();

    // The plan as it is now, and while answers are still on their way to LearningEngine, the plan again once they
    // have arrived (#222). Until then the plan stays with a hint, after the limit the hint offers a reload.
    private async Task LoadAsync()
    {
        if (syncing)
        {
            return;
        }

        await LoadPlanAsync();
        if (state != ViewState.Shown || !Sync.HasPending)
        {
            syncLate = false;
            return;
        }

        syncing = true;
        syncLate = false;
        StateHasChanged();
        bool arrived;
        try
        {
            arrived = (await Sync.WaitAsync()).Arrived;
        }
        finally
        {
            syncing = false;
        }

        syncLate = !arrived;
        if (arrived)
        {
            await LoadPlanAsync();
        }
    }

    // A shown plan stays until the new one is there, so a return doesn't flash a loading hint. Only the newest load
    // counts when two overlap. The documents (#385) come along, a plan with blocks never waits for them.
    private async Task LoadPlanAsync()
    {
        var load = ++loads;
        var planCall = Plans.GetAsync();
        var topicsCall = Material.ListTopicsAsync();
        var documentsCall = Material.ListDocumentsAsync();
        var (planned, topics) = (await planCall, await topicsCall);
        if (load != loads)
        {
            return;
        }

        if (planned.Result == CallResult.SignedOut || topics.Result == CallResult.SignedOut)
        {
            // The shell says the login ran out (SessionEndedNotice). A plan already shown stays, there is nothing else
            // to show here.
            if (state != ViewState.Shown)
            {
                state = ViewState.SignedOut;
            }
        }
        else if (planned.Result != CallResult.Ok || topics.Result != CallResult.Ok)
        {
            // Without names the list would only say "Thema" again and again.
            trace = planned.TraceId ?? topics.TraceId;
            state = ViewState.LoadFailed;
        }
        else
        {
            var next = planned.Value!;
            if (next.Blocks.Count == 0 && next.Empty == PlanEmpty.NoTopics)
            {
                // Nothing to plan from yet, the next step depends on the goals and the documents. Either one failing
                // leaves the hint as it was before #385.
                var goals = await Goals.ListAsync();
                var documents = await documentsCall;
                if (load != loads)
                {
                    return;
                }

                noGoal = goals.Result == CallResult.Ok && goals.Value!.Count == 0;
                analyzing = AnalyzingOf(documents);
            }
            else
            {
                noGoal = false;
                _ = ShowAnalysisAsync(load, documentsCall);
            }

            var wasReached = state == ViewState.Shown && plan?.DailyGoal == DailyGoal.Reached;
            announceGoal = next.DailyGoal == DailyGoal.Reached && !wasReached;
            plan = next;
            names = [];
            foreach (var topic in topics.Value!)
            {
                names.TryAdd(topic.Id, topic.Name);
                foreach (var subtopic in topic.Subtopics)
                {
                    names.TryAdd(subtopic.Id, subtopic.Name);
                }
            }

            state = ViewState.Shown;
        }
    }

    // A plan with blocks shows the documents once they are there. A failed call leaves the hint as it was.
    private async Task ShowAnalysisAsync(int load, Task<CallOutcome<IReadOnlyList<DocumentInfo>>> documentsCall)
    {
        var documents = await documentsCall;
        if (load != loads || documents.Result != CallResult.Ok)
        {
            return;
        }

        analyzing = AnalyzingOf(documents);
        await InvokeAsync(StateHasChanged);
    }

    // The newest material Content is still working on, null when there is none or the call failed.
    private static DocumentInfo? AnalyzingOf(CallOutcome<IReadOnlyList<DocumentInfo>> documents) =>
        documents.Result != CallResult.Ok
            ? null
            : documents.Value!
                .Where(document => document.Status is DocumentStatus.Uploaded or DocumentStatus.Analyzing)
                .OrderByDescending(document => document.CreatedAt)
                .FirstOrDefault();

    // Without topics yet, material in the analysis is why.
    private bool AnalysisIsTheReason =>
        !noGoal && analyzing is not null && plan is { Blocks.Count: 0, Empty: PlanEmpty.NoTopics };

    // Each reason for an empty plan names its own next step. No goal comes first (#385): without one there is nothing
    // to add material to.
    private (string Title, string? Hint, string Link, string Href) Empty => plan?.Empty switch
    {
        _ when noGoal => (FeedbackTexts.Plan.NoGoal, FeedbackTexts.Plan.NoGoalHint, FeedbackTexts.Plan.NoGoalLink, "lernziele/neu"),
        _ when AnalysisIsTheReason => (
            FeedbackTexts.Material.WithTitle(FeedbackTexts.Plan.Analyzing, analyzing!.Title),
            FeedbackTexts.Plan.AnalyzingHint,
            FeedbackTexts.Plan.AnalyzingLink,
            "themen"),
        PlanEmpty.NoTopics => (FeedbackTexts.Plan.NoTopics, FeedbackTexts.Plan.NoTopicsHint, FeedbackTexts.Plan.NoTopicsLink, "themen"),
        PlanEmpty.QuestionsPending => (FeedbackTexts.Plan.QuestionsPending, FeedbackTexts.Plan.QuestionsPendingHint, FeedbackTexts.Plan.QuestionsPendingLink, "themen"),
        PlanEmpty.AllMastered => (FeedbackTexts.Plan.AllMastered, FeedbackTexts.Plan.AllMasteredHint, FeedbackTexts.Plan.AllMasteredLink, "themen"),
        _ => (FeedbackTexts.Plan.Nothing, null, FeedbackTexts.Plan.NothingLink, "themen"),
    };

    private string NameOf(Guid topicId) => names.GetValueOrDefault(topicId) ?? FeedbackTexts.Plan.UnnamedTopic;

    private static string? KindOf(BlockKind? kind) => kind switch
    {
        BlockKind.Learn => FeedbackTexts.Plan.Learn,
        BlockKind.Review => FeedbackTexts.Plan.Review,
        _ => null,
    };

    private static string MinutesOf(int minutes) =>
        $"{minutes} {(minutes == 1 ? FeedbackTexts.Plan.Minute : FeedbackTexts.Plan.Minutes)}";

    private enum ViewState
    {
        Loading,
        SignedOut,
        LoadFailed,
        Shown,
    }
}