@implements IDisposable
@inject IPasswordChange Passwords

<section class="password-section" aria-labelledby="password-heading">
    <h2 id="password-heading">@FeedbackTexts.Password.Heading</h2>

    @* Always there, so a screen reader announces the confirmation. *@
    <div class="password-status" role="status">
        @if (changed)
        {
            <Notice Kind="NoticeKind.Success" class="password-changed"><p>@FeedbackTexts.Password.Changed</p></Notice>
        }
    </div>

    <form class="password-form" @onsubmit="SaveAsync" novalidate>
        <TextField @ref="currentField" Id="password-current" Label="@FeedbackTexts.Password.CurrentLabel"
                   Value="@current" ValueChanged="CurrentTyped" Error="@currentError" Immediate="true" Required="true"
                   type="password" name="current-password" autocomplete="current-password" />
        <TextField @ref="newField" Id="password-new" Label="@FeedbackTexts.Password.NewLabel" Hint="@FeedbackTexts.Password.NewHint"
                   Value="@next" ValueChanged="NewTyped" Error="@newError" Immediate="true" Required="true"
                   type="password" name="new-password" autocomplete="new-password" />
        <TextField @ref="repeatField" Id="password-repeat" Label="@FeedbackTexts.Password.RepeatLabel"
                   Value="@repeat" ValueChanged="RepeatTyped" Error="@repeatError" Immediate="true" Required="true"
                   type="password" name="repeat-password" autocomplete="new-password" />

        @* Always there, so a screen reader announces what went wrong. *@
        <div role="alert">
            @if (limited is not null)
            {
                <Notice Kind="NoticeKind.Warning" class="password-limited"><p>@limited</p></Notice>
            }
            else if (failed)
            {
                <Notice Kind="NoticeKind.Error" class="password-failed">
                    <p>@FeedbackTexts.Password.NotThrough</p>
                    <RequestId Value="@trace" />
                </Notice>
            }
        </div>

        @* Stays enabled while it saves: a disabled button would lose the keyboard focus. *@
        <button type="submit" class="button">@(saving ? FeedbackTexts.Password.Saving : FeedbackTexts.Password.Save)</button>
    </form>
</section>

@code {
    private readonly CancellationTokenSource life = new();
    private TextField? currentField;
    private TextField? newField;
    private TextField? repeatField;
    private string current = "";
    private string next = "";
    private string repeat = "";
    private string? currentError;
    private string? newError;
    private string? repeatError;
    private string? limited;
    private string? trace;
    private bool saving;
    private bool failed;
    private bool changed;

    private void CurrentTyped(string value) => Typed(() => current = value);

    private void NewTyped(string value) => Typed(() => next = value);

    private void RepeatTyped(string value) => Typed(() => repeat = value);

    private void Typed(Action set)
    {
        set();
        changed = false;
    }

    private async Task SaveAsync()
    {
        if (saving)
        {
            return;
        }

        changed = false;
        failed = false;
        limited = null;
        currentError = current.Length == 0 ? FeedbackTexts.Password.CurrentMissing : null;
        newError = next.Length == 0 ? FeedbackTexts.Password.NewMissing : null;
        repeatError = next.Length > 0 && repeat != next ? FeedbackTexts.Password.Mismatch : null;
        if (currentError is not null || newError is not null || repeatError is not null)
        {
            await FocusFirstErrorAsync();
            return;
        }

        saving = true;
        CallOutcome<bool> outcome;
        try
        {
            outcome = await Passwords.ChangeAsync(current, next, life.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        finally
        {
            saving = false;
        }

        switch (outcome.Result)
        {
            case CallResult.Ok:
                current = next = repeat = "";
                changed = true;
                break;
            case CallResult.SignedOut:
                // The shell leads to the login, the fields stay as they are.
                break;
            case CallResult.Rejected when outcome.FieldErrors is { Count: > 0 } errors:
                currentError = errors.GetValueOrDefault(PasswordChangeFields.Current);
                newError = errors.GetValueOrDefault(PasswordChangeFields.New);
                await FocusFirstErrorAsync();
                break;
            case CallResult.Limited:
                limited = outcome.Messages is [var wait, ..] ? wait : FeedbackTexts.Password.Limited;
                break;
            default:
                trace = outcome.TraceId;
                failed = true;
                break;
        }
    }

    // The focus goes to the first field with a message, so the user hears what to fix.
    private async Task FocusFirstErrorAsync()
    {
        StateHasChanged();
        var field = currentError is not null ? currentField : newError is not null ? newField : repeatField;
        if (field is not null)
        {
            await field.FocusAsync();
        }
    }

    public void Dispose()
    {
        life.Cancel();
        life.Dispose();
    }
}
