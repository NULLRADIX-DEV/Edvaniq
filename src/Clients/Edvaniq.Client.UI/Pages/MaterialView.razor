@using Microsoft.Extensions.DependencyInjection
@implements IDisposable
@inject ILearningMaterial Material
@inject IServiceProvider Services

@* The server is the only source: back on the page, it asks anew, the text may have changed on another device. *@
<RefreshOnReturn OnReturn="RefreshOnReturnAsync" />

@* Reloading or closing the page would throw away a text not sent yet, so the browser asks first. *@
<NavigationLock ConfirmExternalNavigation="Unsent" />
<TypingWatch ElementId="paste-text" OnFilledChanged="filled => typing = filled" />

@* The state of the newest text lives in one live region, so a screen reader announces each step. Buttons stay outside,
   they keep the focus. Titles, topics and messages are text from the user or the analysis, Razor writes them as text. *@
<div class="material-status" role="status">
    @switch (State)
    {
        case ViewState.Loading:
            <p>Wird geladen …</p>
            break;
        case ViewState.SignedOut:
            @* The shell says that the login ran out and leads to it (SessionEndedNotice). *@
            @if (Unsent)
            {
                <p class="material-note">@FeedbackTexts.Session.TextKept</p>
            }
            break;
        case ViewState.LoadFailed:
            <ConnectionProblem Title="Der Stand ließ sich gerade nicht laden." TraceId="@loadTrace" />
            break;
        case ViewState.Empty:
            <p class="material-note">
                <strong>Du hast noch keinen Text eingefügt.</strong> Füge unten deinen ersten Text ein, dann erscheinen hier
                deine Themen.
            </p>
            break;
        case ViewState.Analyzing:
            <p class="material-note">
                <strong>„@latest!.Title“ wird analysiert …</strong> Das kann ein paar Minuten dauern. Die Themen erscheinen
                hier von selbst.
            </p>
            break;
        case ViewState.AnalysisSlow:
            <p class="material-note">
                <strong>Die Analyse von „@latest!.Title“ dauert länger als gedacht.</strong> Du kannst weiter warten oder
                später wiederkommen.
            </p>
            break;
        case ViewState.Failed:
            <div class="material-note material-alert">
                <p><strong>Die Analyse von „@latest!.Title“ hat nicht geklappt.</strong></p>
                <p>@(latest.FailureReason ?? "Versuch es noch einmal.")</p>
            </div>
            @if (retryFailed)
            {
                <ConnectionProblem Title="@FeedbackTexts.Retry.NotThrough" TraceId="@retryTrace" />
            }
            break;
        case ViewState.Ready:
            <p class="material-note">Die Themen aus „@latest!.Title“ sind da.</p>
            break;
    }
</div>

@switch (State)
{
    case ViewState.LoadFailed:
        <button type="button" class="button" @onclick="LoadAsync">Erneut laden</button>
        break;
    case ViewState.AnalysisSlow:
        <button type="button" class="button" @onclick="StartFollowing">Weiter warten</button>
        break;
    case ViewState.Failed:
        <button type="button" class="button" @onclick="RetryAnalysisAsync">
            @(retrying ? FeedbackTexts.Retry.Starting : FeedbackTexts.Retry.Button)
        </button>
        break;
}

@if (State is not ViewState.SignedOut and not ViewState.Loading)
{
    @if (topics.Count > 0)
    {
        <section class="material-section" aria-labelledby="topics-heading">
            <h2 id="topics-heading">Themen</h2>
            <ul class="topic-list">
                @foreach (var topic in topics)
                {
                    <li @key="topic.Id">
                        @topic.Name
                        <PracticeLink TopicId="topic.Id" Name="@topic.Name" />
                        @if (topic.Subtopics.Count > 0)
                        {
                            <ul>
                                @foreach (var subtopic in topic.Subtopics)
                                {
                                    <li @key="subtopic.Id">@subtopic.Name <PracticeLink TopicId="subtopic.Id" Name="@subtopic.Name" /></li>
                                }
                            </ul>
                        }
                    </li>
                }
            </ul>
        </section>
    }
}

@* Stays while signed out, so a text typed but not sent doesn't vanish with the login. *@
@if (State is not ViewState.Loading)
{
    <section class="material-section" aria-labelledby="paste-heading">
        <h2 id="paste-heading">@(latest is null ? "Ersten Text einfügen" : "Weiteren Text einfügen")</h2>
        <form class="paste-form" @onsubmit="SubmitAsync" novalidate>
            <div class="paste-field">
                <label for="paste-title">Titel <span class="paste-optional">(freiwillig)</span></label>
                <input id="paste-title" name="title" type="text" autocomplete="off" @bind="title" @bind:event="oninput" />
            </div>
            <div class="paste-field">
                <label for="paste-text">Text</label>
                <textarea id="paste-text" name="text" rows="8" required @bind="text"></textarea>
            </div>

            @* Always there, so a screen reader announces each hint. *@
            <div role="alert">
                @if (formMessages.Count > 0)
                {
                    <div class="material-note material-alert">
                        @foreach (var message in formMessages)
                        {
                            <p>@message</p>
                        }
                        <RequestId Value="@formTrace" />
                    </div>
                }
            </div>

            @* Stays enabled while it sends: a disabled button would lose the keyboard focus. *@
            <button type="submit" class="button">@(submitting ? "Wird gesendet …" : "Themen erkennen")</button>
        </form>
    </section>

    <section class="material-section" aria-labelledby="upload-heading">
        <h2 id="upload-heading">@FeedbackTexts.Upload.Heading</h2>
        <div class="paste-field">
            <label for="upload-file">@FeedbackTexts.Upload.Label</label>
            @* A new key after an upload empties the browser's field. *@
            <InputFile @key="uploadField" id="upload-file" accept="@string.Join(',', UploadExtensions)" aria-describedby="upload-hint"
                       OnChange="FileChosen" />
            <p id="upload-hint" class="paste-optional">@FeedbackTexts.Upload.Hint</p>
        </div>

        <LiveRegion Urgent="true">
            @if (uploadMessages.Count > 0)
            {
                <Notice Kind="NoticeKind.Error" Title="@uploadMessages[0]">
                    @foreach (var message in uploadMessages.Skip(1))
                    {
                        <p>@message</p>
                    }
                    <RequestId Value="@uploadTrace" />
                </Notice>
            }
        </LiveRegion>

        <button type="button" class="button" @onclick="UploadAsync">
            @(uploading ? FeedbackTexts.Upload.Sending : FeedbackTexts.Upload.Button)
        </button>
    </section>
}

@code {
    private const string NotThrough =
        "Der Text ist nicht angekommen. Edvaniq ist gerade nicht erreichbar. Versuch es in ein paar Sekunden noch einmal.";

    private readonly CancellationTokenSource life = new();
    private CancellationTokenSource? follow;
    private Task following = Task.CompletedTask;
    private bool refreshing;
    private MaterialPolling polling = MaterialPolling.Default;

    private bool loading = true;
    private bool signedOut;
    private bool loadFailed;
    private string? loadTrace;
    private bool gaveUp;

    // The newest of the user's documents, the page follows it until its topics are there.
    private DocumentInfo? latest;
    private IReadOnlyList<TopicInfo> topics = [];

    private string title = "";
    private string text = "";
    private bool submitting;
    private IReadOnlyList<string> formMessages = [];
    private string? formTrace;

    private bool retrying;
    private bool retryFailed;
    private string? retryTrace;

    // Checked here only to spare the way up, Content judges the file by its bytes.
    public const long UploadMaxLength = 20L * 1024 * 1024;

    public static readonly IReadOnlyList<string> UploadExtensions = [".pdf", ".docx", ".txt", ".md", ".markdown"];

    private IBrowserFile? chosen;
    private int uploadField;
    private bool uploading;
    private IReadOnlyList<string> uploadMessages = [];
    private string? uploadTrace;

    private enum ViewState
    {
        Loading,
        SignedOut,
        LoadFailed,
        Empty,
        Analyzing,
        AnalysisSlow,
        Failed,
        Ready,
    }

    private ViewState State => this switch
    {
        { signedOut: true } => ViewState.SignedOut,
        { loading: true } => ViewState.Loading,
        { loadFailed: true } => ViewState.LoadFailed,
        { latest: null } => ViewState.Empty,
        { latest.Status: DocumentStatus.Failed } => ViewState.Failed,
        _ when IsAnalyzing => gaveUp ? ViewState.AnalysisSlow : ViewState.Analyzing,
        _ => ViewState.Ready,
    };

    // Content is ready only once Knowledge has the topics of the document, and RefreshAsync asks for the topics only after
    // the documents. So a Ready document always comes with its topics, also when they are all known from earlier texts and
    // none carries its id.
    // A file is read by the worker first, it counts as in analysis like a pasted text.
    private bool IsAnalyzing =>
        latest?.Status is DocumentStatus.Analyzing or DocumentStatus.Uploaded;

    // The text binds on change, a binding on input would send a long text across with every key. Until the change comes,
    // TypingWatch tells that something is typed.
    private bool typing;

    private bool Unsent => typing || !string.IsNullOrWhiteSpace(text) || !string.IsNullOrWhiteSpace(title);

    protected override Task OnInitializedAsync()
    {
        polling = Services.GetService<MaterialPolling>() ?? MaterialPolling.Default;
        if (Services.GetService<Drafts>()?.Take<PasteDraft>(nameof(PasteDraft)) is { } draft)
        {
            title = draft.Title;
            text = draft.Text;
            Show([FeedbackTexts.Session.TextBack]);
        }

        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        loadFailed = false;
        try
        {
            if (await RefreshAsync(documents: true, life.Token))
            {
                StartFollowing();
            }
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            loading = false;
        }
    }

    // Asks for the newest document and for the topics, these only on opening and once the analysis is over. False when
    // that did not get through.
    private async Task<bool> RefreshAsync(bool documents, CancellationToken cancellationToken)
    {
        if (documents)
        {
            var list = await Material.ListDocumentsAsync(cancellationToken);
            if (!Accept(list))
            {
                return false;
            }

            latest = list.Value!.FirstOrDefault();
        }

        if (loading || !IsAnalyzing)
        {
            var found = await Material.ListTopicsAsync(cancellationToken);
            if (!Accept(found))
            {
                return false;
            }

            topics = found.Value!;
        }

        loadFailed = false;
        return true;
    }

    private bool Accept<T>(CallOutcome<T> outcome)
    {
        switch (outcome.Result)
        {
            case CallResult.Ok:
                return true;
            case CallResult.SignedOut:
                signedOut = true;
                return false;
            default:
                loadFailed = true;
                loadTrace = outcome.TraceId;
                return false;
        }
    }

    // Asks again and again while the newest text is analyzed, and stops when it is done (the topics come with that round),
    // when it has waited long enough, or when the user leaves the page.
    private void StartFollowing()
    {
        follow?.Cancel();
        follow?.Dispose();
        gaveUp = false;
        if (!IsAnalyzing)
        {
            follow = null;
            return;
        }

        follow = CancellationTokenSource.CreateLinkedTokenSource(life.Token);
        following = FollowAsync(follow.Token);
    }

    // Back on the page, it asks for the server's state like on opening, but quietly: no loading hint, the live region
    // only speaks when something changed, the focus stays where it is, and the form keeps what the user typed. While the
    // page follows an analysis anyway, or loads or sends right now, there is nothing to add.
    private async Task RefreshOnReturnAsync()
    {
        if (loading || refreshing || submitting || !following.IsCompleted)
        {
            return;
        }

        refreshing = true;
        try
        {
            if (await RefreshAsync(documents: true, life.Token))
            {
                // A new login in another tab counts here too.
                signedOut = false;
                StartFollowing();
            }
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            refreshing = false;
        }
    }

    private async Task FollowAsync(CancellationToken cancellationToken)
    {
        var waited = TimeSpan.Zero;
        try
        {
            while (IsAnalyzing)
            {
                if (waited >= polling.AnalysisLimit)
                {
                    gaveUp = true;
                    StateHasChanged();
                    return;
                }

                var wait = polling.Wait(waited);
                await Task.Delay(wait, cancellationToken);
                waited += wait;

                var through = await RefreshAsync(documents: true, cancellationToken);
                StateHasChanged();
                if (!through)
                {
                    return;
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task SubmitAsync()
    {
        if (submitting)
        {
            return;
        }

        var problem = string.IsNullOrWhiteSpace(text) ? HttpLearningMaterial.EmptyText
            : text.Length > HttpLearningMaterial.TextMaxLength ? HttpLearningMaterial.TextTooLong
            : title.Trim().Length > HttpLearningMaterial.TitleMaxLength ? HttpLearningMaterial.TitleTooLong
            : null;
        if (problem is not null)
        {
            Show([problem]);
            return;
        }

        await PasteAsync(string.IsNullOrWhiteSpace(title) ? null : title.Trim(), text);
    }

    // Content starts the same document again where it failed, the page follows it like a new one. A retry that doesn't
    // start, because the analysis runs again already for instance, asks for the newest state; only if the document is
    // still failed after that, the page says the retry didn't get through.
    private async Task RetryAnalysisAsync()
    {
        if (retrying || latest is not { Status: DocumentStatus.Failed } failed)
        {
            return;
        }

        retrying = true;
        retryFailed = false;
        try
        {
            var outcome = await Material.RetryAsync(failed.Id, life.Token);
            switch (outcome.Result)
            {
                case CallResult.Ok:
                    latest = outcome.Value!;
                    StartFollowing();
                    break;
                case CallResult.SignedOut:
                    signedOut = true;
                    follow?.Cancel();
                    break;
                default:
                    if (await RefreshAsync(documents: true, life.Token))
                    {
                        retryFailed = latest?.Id == failed.Id && latest.Status == DocumentStatus.Failed;
                        retryTrace = outcome.TraceId;
                        StartFollowing();
                    }

                    break;
            }
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            retrying = false;
        }
    }

    private async Task PasteAsync(string? pastedTitle, string pastedText)
    {
        if (submitting)
        {
            return;
        }

        submitting = true;
        Show([]);
        CallOutcome<DocumentInfo> outcome;
        try
        {
            outcome = await Material.PasteAsync(pastedTitle, pastedText, life.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        finally
        {
            submitting = false;
        }

        switch (outcome.Result)
        {
            case CallResult.Ok:
                latest = outcome.Value!;
                retryFailed = false;
                title = "";
                text = "";
                typing = false;
                loadFailed = false;
                StartFollowing();
                break;
            case CallResult.SignedOut:
                signedOut = true;
                follow?.Cancel();
                break;
            case CallResult.Rejected or CallResult.TooLarge:
                Show(outcome.Messages ?? [NotThrough]);
                break;
            default:
                Show([NotThrough], outcome.TraceId);
                break;
        }
    }

    private void FileChosen(InputFileChangeEventArgs args)
    {
        chosen = args.File;
        uploadMessages = [];
        uploadTrace = null;
    }

    private async Task UploadAsync()
    {
        if (uploading)
        {
            return;
        }

        var problem = chosen is null ? FeedbackTexts.Upload.NothingChosen
            : chosen.Size > UploadMaxLength ? FeedbackTexts.Upload.TooLarge
            : !UploadExtensions.Contains(Path.GetExtension(chosen.Name).ToLowerInvariant()) ? FeedbackTexts.Upload.Unsupported
            : null;
        if (problem is not null)
        {
            ShowUpload([problem]);
            return;
        }

        uploading = true;
        ShowUpload([]);
        CallOutcome<DocumentInfo> outcome;
        try
        {
            await using var content = chosen!.OpenReadStream(UploadMaxLength, life.Token);
            outcome = await Material.UploadAsync(chosen.Name, content, life.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (IOException)
        {
            // The file changed or went away after it was chosen.
            outcome = CallOutcome<DocumentInfo>.Failed();
        }
        finally
        {
            uploading = false;
        }

        switch (outcome.Result)
        {
            case CallResult.Ok:
                latest = outcome.Value!;
                chosen = null;
                uploadField++;
                loadFailed = false;
                StartFollowing();
                break;
            case CallResult.SignedOut:
                signedOut = true;
                follow?.Cancel();
                break;
            case CallResult.TooLarge:
                ShowUpload([FeedbackTexts.Upload.TooLarge]);
                break;
            case CallResult.Rejected when outcome.Messages is { Count: > 0 } messages:
                ShowUpload(messages);
                break;
            default:
                ShowUpload([FeedbackTexts.Upload.NotThrough, FeedbackTexts.Connection.Advice], outcome.TraceId);
                break;
        }
    }

    private void ShowUpload(IReadOnlyList<string> messages, string? trace = null)
    {
        uploadMessages = messages;
        uploadTrace = trace;
    }

    private void Show(IReadOnlyList<string> messages, string? trace = null)
    {
        formMessages = messages;
        formTrace = trace;
    }

    private sealed record PasteDraft(string Title, string Text);

    // Leaving for the login keeps what was not sent yet, for the same account only (Drafts).
    public void Dispose()
    {
        if (signedOut && Unsent)
        {
            Services.GetService<Drafts>()?.Keep(nameof(PasteDraft), new PasteDraft(title, text));
        }

        life.Cancel();
        life.Dispose();
        follow?.Dispose();
    }
}