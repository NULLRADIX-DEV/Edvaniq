@* Leads to the summary of the topic. The topic's name is in the link for a screen reader, the list has many of them. *@
<a class="summary-link" href="themen/@TopicId.ToString("D")/zusammenfassung">@FeedbackTexts.Summary.Link<span class="visually-hidden"> zu „@Name“</span></a>

@code {
    [Parameter, EditorRequired]
    public Guid TopicId { get; set; }

    [Parameter, EditorRequired]
    public string Name { get; set; } = "";
}