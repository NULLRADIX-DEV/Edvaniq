@page "/login"
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services

<PageTitle>Anmelden – Edvaniq</PageTitle>

<h1>Anmelden</h1>

@* Only the client can send the login. While the page is prerendered on the server, there is no IWebSession to send it
   with. *@
@if (RendererInfo.IsInteractive)
{
    @if (Services.GetService<SessionWatch>() is { Ended: true })
    {
        <Notice Kind="NoticeKind.Info" Title="@FeedbackTexts.Session.Ended" class="login-ended">
            <p>@FeedbackTexts.Session.OnLogin</p>
        </Notice>
    }

    <LoginForm ReturnTo="@ReturnTo" />
}
else
{
    <PageLoading />
}

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnTo { get; set; }
}