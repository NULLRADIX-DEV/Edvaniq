@inject IWebSession Session
@inject NavigationManager Navigation
@inject AuthenticationStateProvider Authentication
@inject IJSRuntime JS
@inject IAccountConfirmations Confirmations
@using Microsoft.JSInterop

<form class="login-form" @onsubmit="SignInAsync" novalidate>
    <div class="login-field">
        <label for="login-name">E-Mail oder Name</label>
        <input id="login-name" name="username" type="text" autocomplete="username" autocapitalize="none"
               spellcheck="false" required @bind="name" />
    </div>
    <div class="login-field">
        <label for="login-password">Passwort</label>
        <input id="login-password" name="password" type="password" autocomplete="current-password" required
               @bind="password" />
    </div>

    @* Always there, so a screen reader announces each hint. *@
    <div role="alert">
        @switch (refusal)
        {
            case SignInResult.AwaitingApproval:
                @* Not an error: the account is fine, it only waits. So it looks unlike the other hints. *@
                <Notice Kind="NoticeKind.Info" Title="@FeedbackTexts.Login.AwaitingApprovalTitle" class="login-approval">
                    <p>@hint</p>
                </Notice>
                break;
            case SignInResult.Unconfirmed:
                <Notice Kind="NoticeKind.Warning" class="login-unconfirmed">
                    <p>@hint</p>
                    @if (resendTo is not null)
                    {
                        @if (resendNote is not null)
                        {
                            <p class="login-resend-note">@resendNote</p>
                        }
                        @* Stays enabled while it runs, for the same reason as the login button. *@
                        <button type="button" class="button button-secondary" @onclick="ResendAsync">
                            @(resending ? FeedbackTexts.Login.Resending : FeedbackTexts.Login.Resend)
                        </button>
                    }
                </Notice>
                break;
            default:
                @if (hint is not null)
                {
                    <div class="login-hint">
                        <p>@hint</p>
                        <RequestId Value="@traceId" />
                    </div>
                }
                break;
        }
    </div>

    @* Stays enabled while a login runs: a disabled button would lose the keyboard focus. *@
    <button type="submit" class="button">@(signingIn ? "Anmeldung läuft …" : "Anmelden")</button>
</form>

@code {
    public const string FormValuesModule = "./_content/Edvaniq.Client.UI/form-values.js";
    private const string NameId = "login-name";
    private const string PasswordId = "login-password";

    // Where to go once signed in, only a path of this site (ReturnUrl).
    [Parameter]
    public string? ReturnTo { get; set; }

    private string name = "";
    private string password = "";
    private string? hint;
    private string? traceId;
    private SignInResult? refusal;
    private bool signingIn;

    // The address a new confirmation link goes to: what was typed for the unconfirmed login, only if it is an address.
    private string? resendTo;
    private string? resendNote;
    private bool resending;

    private async Task SignInAsync()
    {
        if (signingIn)
        {
            return;
        }

        signingIn = true;
        await TakeWhatTheFieldsShowAsync();
        if (string.IsNullOrWhiteSpace(name) || string.IsNullOrEmpty(password))
        {
            signingIn = false;
            Show(FeedbackTexts.Login.Missing);
            return;
        }

        var login = name.Trim();
        var outcome = await Session.SignInAsync(login, password);
        signingIn = false;

        if (outcome.Result == SignInResult.SignedIn)
        {
            // Waits for the new state, so the drafts know whose they are before a page asks for them.
            if (Authentication is SessionAuthenticationState state)
            {
                await state.Refresh();
            }

            Navigation.NavigateTo(ReturnUrl.Target(ReturnTo));
            return;
        }

        password = "";
        Show(Hint(outcome), outcome.TraceId, outcome.Result);

        // A team name never waits for a confirmation, and a name must not go out as an address.
        if (outcome.Result == SignInResult.Unconfirmed && login.Contains('@'))
        {
            resendTo = login;
        }
    }

    private async Task ResendAsync()
    {
        if (resending || resendTo is null)
        {
            return;
        }

        resending = true;
        var outcome = await Confirmations.ResendAsync(resendTo);
        resending = false;
        resendNote = outcome.Result switch
        {
            ResendResult.Sent when outcome.MailDelayed => $"{FeedbackTexts.Login.Resent} {FeedbackTexts.Login.MailDelayed}",
            ResendResult.Sent => FeedbackTexts.Login.Resent,
            ResendResult.Limited => string.Format(FeedbackTexts.Login.ResendLimited, Wait(outcome.RetryAfter ?? TimeSpan.FromMinutes(10))),
            _ => FeedbackTexts.Login.ResendUnavailable,
        };
    }

    // Autofill and password managers may fill the fields without an event, so the binding can still be empty. What the
    // fields show wins, that's what the user sees. Without the script the bound values stay.
    private async Task TakeWhatTheFieldsShowAsync()
    {
        try
        {
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", FormValuesModule);
            var values = await module.InvokeAsync<string?[]?>("read", new object[] { new[] { NameId, PasswordId } });
            if (values is [var shownName, var shownPassword])
            {
                name = shownName ?? name;
                password = shownPassword ?? password;
            }
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or InvalidOperationException)
        {
            // No script, the binding has to do.
        }
    }

    private void Show(string text, string? trace = null, SignInResult? result = null)
    {
        hint = text;
        traceId = trace;
        refusal = result;
        resendTo = null;
        resendNote = null;
    }

    // The wait comes from Retry-After, also for a locked login, so it is always said in the same words.
    private static string Hint(SignInOutcome outcome) => outcome.Result switch
    {
        SignInResult.WrongCredentials => FeedbackTexts.Login.WrongCredentials,
        SignInResult.TooManyAttempts => string.Format(FeedbackTexts.Login.TooManyAttempts, Wait(outcome.RetryAfter)),
        SignInResult.Unconfirmed => outcome.Title ?? FeedbackTexts.Login.Unconfirmed,
        SignInResult.AwaitingApproval => outcome.Title ?? FeedbackTexts.Login.AwaitingApproval,
        _ => FeedbackTexts.Login.Unavailable,
    };

    private static string Wait(TimeSpan? retryAfter)
    {
        var seconds = (int)Math.Ceiling((retryAfter ?? TimeSpan.FromMinutes(1)).TotalSeconds);
        return seconds switch
        {
            <= 1 => "einen Moment",
            < 60 => $"{seconds} Sekunden",
            60 => "eine Minute",
            _ => $"{(int)Math.Ceiling(seconds / 60.0)} Minuten",
        };
    }
}