@using Microsoft.Extensions.DependencyInjection
@using Microsoft.JSInterop
@implements IDisposable
@inject IQuiz Quiz
@inject ILearningMaterial Material
@inject IServiceProvider Services

@* Back on the page, a hint gives way to a question once there is one, and the topic's name follows a rename. An open
   attempt stays as it is: it belongs to the question asked, a new one with each return would be wrong. *@
<RefreshOnReturn OnReturn="RefreshOnReturnAsync" />

<h1 tabindex="-1" @ref="pageHeading">@(topicName is null ? "Frage üben" : $"Frage zu „{topicName}“")</h1>

<div class="quiz-status" role="status">
    @switch (State)
    {
        case ViewState.Loading:
            <Loading Text="@FeedbackTexts.Quiz.Loading" />
            break;
        case ViewState.SignedOut:
            @* No question yet: the shell says that the login ran out and leads to it (SessionEndedNotice). *@
            break;
        case ViewState.NotReady when ownTopic:
            <EmptyState Title="@FeedbackTexts.Quiz.NoQuestionsOwnTopic" Hint="@FeedbackTexts.Quiz.NoQuestionsOwnTopicHint" />
            break;
        case ViewState.NotReady:
            <EmptyState Title="@FeedbackTexts.Quiz.NoQuestions" Hint="@FeedbackTexts.Quiz.NoQuestionsHint" />
            break;
        case ViewState.NotFound:
            <Notice Kind="NoticeKind.Error" Title="@FeedbackTexts.Quiz.TopicGone" class="quiz-topic-gone" />
            break;
        case ViewState.Question when announceRepeated:
            @* Said once when the questions start to come again, not with every one after. *@
            <span class="visually-hidden">@FeedbackTexts.Quiz.Repeated</span>
            break;
        case ViewState.LoadFailed:
            <ConnectionProblem Title="@FeedbackTexts.Quiz.LoadFailed" TraceId="@loadTrace" />
            break;
        case ViewState.UnknownType:
            <Notice Kind="NoticeKind.Info" Title="@FeedbackTexts.Quiz.UnknownType" class="quiz-unknown-type">
                <p>@FeedbackTexts.Quiz.UnknownTypeHint</p>
            </Notice>
            break;
    }
</div>

@switch (State)
{
    case ViewState.NotReady when ownTopic:
        <StateActions Href="themen" LinkText="@FeedbackTexts.Quiz.OtherTopic" />
        break;
    case ViewState.NotReady:
        <StateActions ActionText="@FeedbackTexts.Quiz.AskAgain" OnAction="() => AskAsync(focus: true)"
                      Href="themen" LinkText="@FeedbackTexts.Quiz.OtherTopic">
            <a class="quiz-summary-link" href="@SummaryHref">@FeedbackTexts.Quiz.ReadSummary@NameForReaders()</a>
        </StateActions>
        break;
    case ViewState.NotFound:
        <StateActions Href="themen" LinkText="@FeedbackTexts.Quiz.BackToTopics" />
        break;
    case ViewState.LoadFailed:
        <StateActions ActionText="@FeedbackTexts.Connection.Retry" OnAction="() => AskAsync(focus: true)"
                      Href="themen" LinkText="@FeedbackTexts.Quiz.BackToTopics" />
        break;
    case ViewState.UnknownType:
        <div class="quiz-actions">
            <button type="button" class="button" @onclick="() => AskAsync(focus: true)">Nächste Frage</button>
            <a href="themen">Zurück zu den Themen</a>
        </div>
        break;
    case ViewState.Question:
        @if (asked!.Repeated == true)
        {
            <Notice Kind="NoticeKind.Info" Title="@FeedbackTexts.Quiz.Repeated" class="quiz-repeated">
                <p>@FeedbackTexts.Quiz.RepeatedHint</p>
                <p class="quiz-repeated-ways">
                    <a href="@SummaryHref">@FeedbackTexts.Quiz.ReadSummary@NameForReaders()</a>
                    <a href="themen">@FeedbackTexts.Quiz.OtherTopic</a>
                </p>
            </Notice>
        }
        <QuestionCard Round="askCount" Question="asked!" TopicId="TopicId" Documents="documents" FocusOnShow="focusQuestion"
                      Resume="resume" DraftKey="@DraftKey" OnGone="GoneAsync">
            <Next>
                <div class="quiz-actions">
                    <button type="button" class="button" @onclick="() => AskAsync(focus: true)">Nächste Frage</button>
                    <a href="themen">Zurück zu den Themen</a>
                </div>
            </Next>
        </QuestionCard>
        break;
}

@code {
    [Parameter]
    public Guid TopicId { get; set; }

    private readonly CancellationTokenSource life = new();
    private DocumentLookup documents = default!;
    private Guid? loadedTopic;

    private bool loading = true;
    private bool askingNow;
    private bool signedOut;
    private CallResult? askFailure;
    private string? loadTrace;
    private string? topicName;

    // The user made the topic (#317): no document, so no questions will come from one (#388).
    private bool ownTopic;

    // The questions just started to come again (#387), the live region says so once.
    private bool announceRepeated;

    private AskedQuestion? asked;

    // Each ask starts the card afresh, even when the server brings the same attempt again.
    private int askCount;

    // The open question back from the login, handed to the card once.
    private QuestionDraft? resume;
    private bool focusQuestion;

    private ElementReference pageHeading;
    private bool focusPage;

    private enum ViewState
    {
        Loading,
        SignedOut,
        NotReady,
        NotFound,
        LoadFailed,
        UnknownType,
        Question,
    }

    private ViewState State => this switch
    {
        { signedOut: true, asked: null } => ViewState.SignedOut,
        { loading: true } => ViewState.Loading,
        { askFailure: CallResult.NotReady } => ViewState.NotReady,
        { askFailure: CallResult.NotFound } => ViewState.NotFound,
        { askFailure: not null } => ViewState.LoadFailed,
        { asked.IsKnownType: false } => ViewState.UnknownType,
        { asked: not null } => ViewState.Question,
        _ => ViewState.Loading,
    };

    private string DraftKey => $"{nameof(QuestionDraft)}:{TopicId:D}";

    private string SummaryHref => $"themen/{TopicId:D}/zusammenfassung";

    // The topic's name in the link for a screen reader, as SummaryLink has it.
    private RenderFragment NameForReaders() => builder =>
    {
        if (topicName is not null)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "visually-hidden");
            builder.AddContent(2, $" zu „{topicName}“");
            builder.CloseElement();
        }
    };

    protected override void OnInitialized() => documents = new DocumentLookup(Material);

    protected override async Task OnParametersSetAsync()
    {
        if (loadedTopic == TopicId)
        {
            return;
        }

        loadedTopic = TopicId;
        topicName = null;
        ownTopic = false;

        // Back from the login: the same open attempt, so the answer goes to it and counts once.
        if (Services.GetService<Drafts>()?.Take<QuestionDraft>(DraftKey) is { } open)
        {
            asked = open.Asked;
            resume = open;
            loading = false;
            focusQuestion = true;
            await LoadTopicNameAsync();
            return;
        }

        await Task.WhenAll(AskAsync(focus: false), LoadTopicNameAsync());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusPage)
        {
            return;
        }

        focusPage = false;
        try
        {
            await pageHeading.FocusAsync();
        }
        catch (JSException)
        {
            // The element went away between render and focus, nothing to do.
        }
    }

    // The heading names the topic. Without it the page still works, so a failure here shows nothing.
    private async Task LoadTopicNameAsync()
    {
        CallOutcome<IReadOnlyList<TopicInfo>> topics;
        try
        {
            topics = await Material.ListTopicsAsync(life.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (topics is { Result: CallResult.Ok, Value: { } list })
        {
            var found = list.Select(topic => (topic.Id, topic.Name, topic.DocumentId))
                .Concat(list.SelectMany(topic => topic.Subtopics).Select(subtopic => (subtopic.Id, subtopic.Name, subtopic.DocumentId)))
                .Where(entry => entry.Id == TopicId)
                .ToList();

            // Not found, the topic counts as one from material: its questions may still come.
            topicName = found is [var match, ..] ? match.Name : null;
            ownTopic = found is [{ DocumentId: null }, ..];
        }
    }

    // Quietly, without a loading hint, so the live region only speaks when the answer is new. Assessment only starts an
    // attempt when it has a question, so asking again after 409 leaves nothing open.
    private async Task RefreshOnReturnAsync()
    {
        if (loading || askingNow)
        {
            return;
        }

        var name = LoadTopicNameAsync();
        if (State is ViewState.NotReady or ViewState.LoadFailed)
        {
            await Task.WhenAll(name, AskAsync(focus: false, quiet: true));
            return;
        }

        await name;
    }

    // A new attempt with a new question. Opened again, the page asks anew: an attempt left open counts nowhere.
    private async Task AskAsync(bool focus, bool quiet = false)
    {
        if (askingNow)
        {
            return;
        }

        askingNow = true;
        loading = !quiet;
        CallOutcome<AskedQuestion> outcome;
        try
        {
            outcome = await Quiz.AskAsync(TopicId, life.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        finally
        {
            askingNow = false;
            loading = false;
        }

        var wasRepeated = asked?.Repeated == true;
        asked = null;
        resume = null;
        askFailure = null;
        announceRepeated = false;
        loadTrace = null;
        switch (outcome.Result)
        {
            case CallResult.Ok:
                asked = outcome.Value!;
                askCount++;
                announceRepeated = asked.Repeated == true && !wasRepeated;
                break;
            case CallResult.SignedOut:
                signedOut = true;
                break;
            default:
                askFailure = outcome.Result is CallResult.NotReady or CallResult.NotFound ? outcome.Result : CallResult.Failed;
                loadTrace = outcome.TraceId;
                break;
        }

        // Quietly back with a question, the hint and its button are gone: the focus goes where the button would have
        // taken it.
        focusQuestion = asked is { IsKnownType: true } && (focus || quiet);
        focusPage = focus && !focusQuestion;
    }

    // The topic went away while its question was open.
    private Task GoneAsync()
    {
        asked = null;
        resume = null;
        askFailure = CallResult.NotFound;
        focusPage = true;
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        life.Cancel();
        life.Dispose();
    }
}