@using System.Globalization
@using Microsoft.JSInterop
@implements IDisposable
@inject IBlockQuiz Quizzes
@inject ILearningMaterial Material

@* The quiz of a block: its questions one after another through QuestionSteps, then how many were right. The session
   runner (#396) puts this in its quiz step and takes the tally from OnFinished. *@

<div class="quiz-status" role="status">
    @switch (State)
    {
        case ViewState.Loading:
            <Loading Text="@FeedbackTexts.Quiz.Loading" />
            break;
        case ViewState.NotReady:
            <EmptyState Title="@FeedbackTexts.Quiz.NoQuestions" Hint="@FeedbackTexts.Quiz.NoQuestionsHint" />
            break;
        case ViewState.NotFound:
            <Notice Kind="NoticeKind.Error" Title="@FeedbackTexts.Quiz.TopicGone" class="quiz-topic-gone" />
            break;
        case ViewState.LoadFailed:
            <ConnectionProblem Title="@FeedbackTexts.BlockQuiz.LoadFailed" TraceId="@loadTrace" />
            break;
        case ViewState.Question when !run!.Current.IsKnownType:
            <Notice Kind="NoticeKind.Info" Title="@FeedbackTexts.Quiz.UnknownType" class="quiz-unknown-type">
                <p>@FeedbackTexts.Quiz.UnknownTypeHint</p>
            </Notice>
            break;
    }
</div>

@* Before the questions, not in their run: the quiz is shorter or repeats one (#387, #388). *@
@if (State is ViewState.Question && poolTooSmall)
{
    <Notice Kind="NoticeKind.Info" Title="@FeedbackTexts.BlockQuiz.PoolTooSmall" class="block-quiz-small-pool">
        <p>@FeedbackTexts.BlockQuiz.PoolTooSmallHint</p>
    </Notice>
}

@switch (State)
{
    case ViewState.NotReady:
        <StateActions ActionText="@FeedbackTexts.Quiz.AskAgain" OnAction="OpenAsync"
                      Href="themen" LinkText="@FeedbackTexts.Quiz.OtherTopic">
            <a class="block-quiz-summary-link" href="themen/@TopicId.ToString("D")/zusammenfassung">@FeedbackTexts.Quiz.ReadSummary</a>
        </StateActions>
        break;
    case ViewState.NotFound:
        <StateActions Href="themen" LinkText="@FeedbackTexts.Quiz.BackToTopics" />
        break;
    case ViewState.LoadFailed:
        <StateActions ActionText="@FeedbackTexts.Connection.Retry" OnAction="OpenAsync"
                      Href="themen" LinkText="@FeedbackTexts.Quiz.BackToTopics" />
        break;
    case ViewState.Question:
        <QuestionSteps Run="run!" TopicId="TopicId" Documents="documents" FocusOnShow="retried" OnMoved="MovedAsync" OnGone="Gone" />
        break;
    case ViewState.Done:
        <section class="block-quiz-done" aria-labelledby="block-quiz-done-heading">
            <h2 id="block-quiz-done-heading" tabindex="-1" @ref="doneHeading">@FeedbackTexts.BlockQuiz.Done</h2>
            <p class="block-quiz-tally"><strong>@TallyText</strong></p>
            <p>@FeedbackTexts.BlockQuiz.DoneHint</p>
        </section>
        @AfterDone
        break;
}

@code {
    // How many questions a block's quiz gets until the runner takes the number from the block (#396).
    public const int DefaultSize = 10;

    [Parameter, EditorRequired]
    public Guid TopicId { get; set; }

    [Parameter, EditorRequired]
    public Guid BlockId { get; set; }

    // Only counts when the quiz is made. Once it is there, the questions are the ones it has.
    [Parameter]
    public int Size { get; set; } = DefaultSize;

    // Once all questions are through, with what this view counted. It's the display only: what a session counts comes
    // from Planning's result (#403).
    [Parameter]
    public EventCallback<QuizTally> OnFinished { get; set; }

    // The caller's way on below the tally.
    [Parameter]
    public RenderFragment? AfterDone { get; set; }

    private readonly CancellationTokenSource life = new();
    private DocumentLookup documents = default!;
    private (Guid Topic, Guid Block)? loaded;

    private bool loading = true;
    private CallResult? openFailure;
    private string? loadTrace;
    private QuestionRun? run;
    private bool poolTooSmall;

    // Opened again after a failure: the user did something, so the first question takes the focus. Never on the first load.
    private bool retried;
    private bool focusDone;
    private ElementReference doneHeading;

    private enum ViewState
    {
        Loading,
        SignedOut,
        NotReady,
        NotFound,
        LoadFailed,
        Question,
        Done,
    }

    private ViewState State => this switch
    {
        { loading: true } => ViewState.Loading,
        { openFailure: CallResult.SignedOut } => ViewState.SignedOut,
        { openFailure: CallResult.NotReady } => ViewState.NotReady,
        { openFailure: CallResult.NotFound } => ViewState.NotFound,
        { openFailure: not null } => ViewState.LoadFailed,
        { run.IsDone: false } => ViewState.Question,
        { run: not null } => ViewState.Done,
        _ => ViewState.Loading,
    };

    private string TallyText =>
        string.Format(CultureInfo.InvariantCulture, FeedbackTexts.BlockQuiz.Tally, run!.Tally.Right, run.Tally.Total);

    protected override void OnInitialized() => documents = new DocumentLookup(Material);

    protected override async Task OnParametersSetAsync()
    {
        if (loaded == (TopicId, BlockId))
        {
            return;
        }

        loaded = (TopicId, BlockId);
        await OpenAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusDone)
        {
            return;
        }

        focusDone = false;
        try
        {
            await doneHeading.FocusAsync();
        }
        catch (JSException)
        {
            // The element went away between render and focus, nothing to do.
        }
    }

    // Safe to call again: Assessment keeps the quiz of the block and brings the same questions.
    private async Task OpenAsync()
    {
        var retry = !loading;
        loading = true;
        CallOutcome<BlockQuiz> outcome;
        try
        {
            outcome = await Quizzes.OpenAsync(TopicId, BlockId, Size, life.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        finally
        {
            loading = false;
        }

        openFailure = null;
        loadTrace = null;
        if (outcome is { Result: CallResult.Ok, Value: { } opened })
        {
            // Back to a quiz begun before: what was answered then counts, it goes on with the first open question.
            retried = retry;
            poolTooSmall = opened.PoolTooSmall;
            run = new QuestionRun(opened.Questions.Select(question => new RunQuestion(question.Asked, question.Answered, question.Correct)));
            if (run.IsDone)
            {
                await FinishAsync(focus: retry);
            }

            return;
        }

        openFailure = outcome.Result is CallResult.SignedOut or CallResult.NotReady or CallResult.NotFound ? outcome.Result : CallResult.Failed;
        loadTrace = outcome.TraceId;
    }

    private async Task MovedAsync()
    {
        if (run!.IsDone)
        {
            await FinishAsync(focus: true);
        }
    }

    private async Task FinishAsync(bool focus)
    {
        focusDone = focus;
        await OnFinished.InvokeAsync(run!.Tally);
    }

    private void Gone()
    {
        run = null;
        poolTooSmall = false;
        openFailure = CallResult.NotFound;
    }

    public void Dispose()
    {
        life.Cancel();
        life.Dispose();
    }
}