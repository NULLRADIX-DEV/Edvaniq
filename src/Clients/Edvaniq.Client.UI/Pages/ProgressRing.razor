@using System.Globalization

@* #383: how much of today is done, as a ring and as text. Screen readers read the text, the ring is only a picture of
   it. *@
<div class="progress">
    <svg class="progress-ring" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
        <circle class="progress-track" cx="20" cy="20" r="16" pathLength="100" />
        <circle class="progress-fill" cx="20" cy="20" r="16" pathLength="100"
                stroke-dasharray="@Percent.ToString(CultureInfo.InvariantCulture) 100" />
    </svg>
    <p class="progress-text">@Text</p>
</div>

@code {
    [Parameter, EditorRequired]
    public int Done { get; set; }

    [Parameter, EditorRequired]
    public int Total { get; set; }

    private int Percent => Total <= 0 ? 0 : Math.Clamp(Done * 100 / Total, 0, 100);

    private string Text => string.Format(
        CultureInfo.InvariantCulture,
        FeedbackTexts.Plan.Progress,
        Done,
        Total,
        Total == 1 ? FeedbackTexts.Plan.Block : FeedbackTexts.Plan.Blocks);
}