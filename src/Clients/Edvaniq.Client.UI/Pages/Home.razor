@page "/"

<PageTitle>Start – Edvaniq</PageTitle>

<h1>Start</h1>

<AuthorizeView>
    <Authorized>
        @* Only the browser talks to Planning. While the page is prerendered on the server there is nobody to ask. *@
        @if (RendererInfo.IsInteractive)
        {
            <TodayPlanView />
            <p><a href="plan">@FeedbackTexts.Plan.WeekLink</a></p>
        }
        else
        {
            <PageLoading />
        }
    </Authorized>
    <NotAuthorized>
        <p>Edvaniq ist noch im Aufbau. Bald planst du hier deine Lernziele und siehst, was heute dran ist.</p>
    </NotAuthorized>
</AuthorizeView>