@page "/themen/{TopicId:guid}/zusammenfassung"
@attribute [Authorize]

<PageTitle>Zusammenfassung – Edvaniq</PageTitle>

@* Only the browser talks to Content. While the page is prerendered on the server there is nobody to ask. *@
@if (RendererInfo.IsInteractive)
{
    <SummaryView TopicId="TopicId" />
}
else
{
    <h1>Zusammenfassung</h1>
    <PageLoading />
}

@code {
    [Parameter]
    public Guid TopicId { get; set; }
}