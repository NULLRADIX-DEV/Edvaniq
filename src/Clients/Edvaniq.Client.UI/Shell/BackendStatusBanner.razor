@inject IBackendStatus Backend

@* Back in the tab, or back online, a shown hint checks once more by itself. Only then: a check on a timer would go on
   asking while nobody looks. *@
<RefreshOnReturn OnReturn="CheckAgainAsync" />

@* The live region is always there, so a screen reader announces the hint when it appears, and the all-clear when it
   goes away again. The button stays outside, a changing region would take its focus along. *@
<div class="backend-banner">
    <LiveRegion>
        @if (!reachable)
        {
            <ConnectionProblem Title="Keine Verbindung zu Edvaniq." />
        }
        else if (reconnected)
        {
            <p class="visually-hidden">Die Verbindung zum Server ist wieder da.</p>
        }
    </LiveRegion>
    @if (!reachable)
    {
        <button type="button" class="button" @onclick="CheckAsync">
            @(checking ? "Wird geprüft …" : "Erneut versuchen")
        </button>
    }
</div>

@code {
    private bool reachable = true;
    private bool reconnected;
    private bool checking;

    // Called when a retry succeeds. The button that had the focus is gone then, so the shell gives the focus a new place.
    [Parameter]
    public EventCallback OnReconnected { get; set; }

    protected override Task OnInitializedAsync() => CheckAsync();

    private Task CheckAgainAsync() => reachable ? Task.CompletedTask : CheckAsync();

    // The button stays enabled while checking: a disabled button would lose the keyboard focus.
    private async Task CheckAsync()
    {
        if (checking)
        {
            return;
        }

        var wasDown = !reachable;
        checking = true;
        reachable = await Backend.IsReachableAsync();
        checking = false;

        if (wasDown && reachable)
        {
            reconnected = true;
            await OnReconnected.InvokeAsync();
        }
    }
}