<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\Edvaniq.Services.Content.UnitTests\ReferenceSet.cs" Link="ReferenceSet.cs" />
    <Compile Include="..\Edvaniq.Services.Content.UnitTests\ReferenceScore.cs" Link="ReferenceScore.cs" />
    <Compile Include="..\Edvaniq.Services.Content.UnitTests\TestDocx.cs" Link="TestDocx.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\Services\Content\Edvaniq.Services.Content.Api\Edvaniq.Services.Content.Api.csproj" />
    <!-- Only so the worker lies next to the tests: they start it as the reading process (FileReader). -->
    <ProjectReference Include="..\..\..\..\src\Services\Content\Edvaniq.Services.Content.Worker\Edvaniq.Services.Content.Worker.csproj" Aliases="worker" />
    <ProjectReference Include="..\..\..\Edvaniq.Testing\Edvaniq.Testing.csproj" />
  </ItemGroup>

</Project>
