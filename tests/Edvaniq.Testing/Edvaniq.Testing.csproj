<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Testcontainers.MySql" />
    <PackageReference Include="Testcontainers.Nats" />
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>

  <!-- OwnedRows counts the rows of a user in any service's DbContext. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\BuildingBlocks\Edvaniq.BuildingBlocks.Infrastructure\Edvaniq.BuildingBlocks.Infrastructure.csproj" />
  </ItemGroup>

  <!-- IsolationCheck leaves out the endpoints for internal tokens. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\BuildingBlocks\Edvaniq.BuildingBlocks.Web\Edvaniq.BuildingBlocks.Web.csproj" />
  </ItemGroup>

  <!-- The grant of a service's DB user, shared with the AppHost. -->
  <ItemGroup>
    <Compile Include="..\..\src\Aspire\Edvaniq.AppHost\ServiceDatabaseSql.cs" Link="ServiceDatabaseSql.cs" />
  </ItemGroup>

  <!-- The shipped event messages, EventSamples reads them next to each test. -->
  <ItemGroup>
    <Content Include="..\EventSamples\*.json" Link="EventSamples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

</Project>
