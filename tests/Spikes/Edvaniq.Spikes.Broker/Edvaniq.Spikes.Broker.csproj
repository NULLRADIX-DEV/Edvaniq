<Project Sdk="Microsoft.NET.Sdk">

  <!-- Throwaway spike, the real broker connection replaces it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers.Nats" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Edvaniq.Spikes.Broker.Consumer\Edvaniq.Spikes.Broker.Consumer.csproj" />
    <ProjectReference Include="..\..\Edvaniq.Testing\Edvaniq.Testing.csproj" />
  </ItemGroup>

  <!-- The consumer runs from its own output. Ours drops packages that ASP.NET Core brings, which the consumer doesn't load. -->
  <ItemGroup>
    <AssemblyMetadata Include="ConsumerPath" Value="$(MSBuildThisFileDirectory)../Edvaniq.Spikes.Broker.Consumer/bin/$(Configuration)/$(TargetFramework)/Edvaniq.Spikes.Broker.Consumer.dll" />
  </ItemGroup>

</Project>
