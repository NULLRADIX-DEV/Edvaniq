<Project>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <IsPackable>false</IsPackable>
    <Company>Nullradix</Company>
    <Product>Edvaniq</Product>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CI)' == 'true' Or '$(TF_BUILD)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Container image name = Aspire resource name, e.g. Edvaniq.Services.Identity.Api -> nullradix-dev/edvaniq/identity-api.
       PublishRepositoryUrl adds the commit (org.opencontainers.image.revision) and repo URL as image labels. -->
  <PropertyGroup>
    <ContainerRepository>nullradix-dev/edvaniq/$(MSBuildProjectName.Replace('Edvaniq.Services.', '').Replace('Edvaniq.', '').Replace('.', '-').ToLowerInvariant())</ContainerRepository>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

</Project>
